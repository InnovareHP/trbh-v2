---
import FocusPage from "../../components/our-focus/focus/focus";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { focus: "psychiatric-inpatient-treatment-program" } },
    { params: { focus: "conditions-and-therapy-programs" } },
    { params: { focus: "nutrition-program" } },
    { params: { focus: "brochure" } },
  ];
}

const { focus } = Astro.params;

// SEO Data for each page
const seoData: Record<string, any> = {
  "psychiatric-inpatient-treatment-program": {
    title: "Psychiatric Inpatient Treatment | Three Rivers, West Mifflin PA",
    description: "24/7 psychiatric inpatient treatment for adults and seniors in mental health crisis. Care for depression, anxiety, psychosis and more in West Mifflin, PA.",
    keywords: "psychiatric inpatient program, mental health crisis hospitalization, when to hospitalize for mental health, inpatient psychiatric care for elderly, adult psychiatric hospitalization Pittsburgh, 24/7 mental health crisis care, emergency psychiatric admission, what is inpatient psychiatric treatment, how long is psychiatric hospitalization, involuntary psychiatric commitment Pennsylvania, voluntary psychiatric admission, psychiatric hospital for suicidal ideation, inpatient care severe depression, acute psychiatric care seniors, mental health crisis intervention adults, psychiatric stabilization program, short-term psychiatric hospitalization, inpatient mental health for elderly parents, Medicare inpatient psychiatric care, what happens during psychiatric hospitalization, psychiatric hospital daily routine, inpatient treatment schizophrenia, psychosis hospitalization, severe anxiety inpatient care, elderly depression hospitalization, geriatric psychiatric inpatient unit, adult mental health crisis admission, family involvement inpatient psychiatric care",
    ogTitle: "24/7 Psychiatric Inpatient Treatment | Three Rivers Behavioral Health",
    ogDescription: "Immediate psychiatric crisis care and inpatient treatment for adults and seniors. Expert care for depression, anxiety, psychosis, and mental health emergencies.",
    structuredData: {
      "@context": "https://schema.org",
      "@type": "MedicalTherapy",
      "name": "Psychiatric Inpatient Treatment Program",
      "provider": { "@id": "https://trbhcares.com/#hospital" },
      "description": "24/7 comprehensive psychiatric inpatient care for adults and seniors experiencing acute mental health crises including depression, anxiety, psychosis, and other psychiatric emergencies.",
      "availableService": {
        "@type": "MedicalProcedure",
        "name": "Crisis Psychiatric Care"
      }
    }
  },
  "conditions-and-therapy-programs": {
    title: "Conditions & Therapy Programs (EMDR, DBT) | Three Rivers",
    description: "Therapy for anxiety, depression, PTSD, schizophrenia, dementia and more, including EMDR and DBT, for adults and seniors in West Mifflin, PA.",
    keywords: "what mental health conditions are treated, anxiety treatment programs elderly, depression therapy seniors Pittsburgh, PTSD treatment adults Pennsylvania, schizophrenia treatment programs, dementia behavioral therapy, Alzheimer's psychiatric care, EMDR therapy for trauma elderly, DBT therapy adults Pittsburgh, bipolar disorder treatment seniors, psychosis treatment programs, what is EMDR therapy, what is DBT therapy, trauma therapy for older adults, mental health conditions we treat, psychiatric treatment for dementia patients, elderly anxiety therapy programs, senior depression treatment options, neuropsychiatric disorder treatment, brain injury mental health treatment, stroke psychiatric care, post-traumatic stress elderly veterans, acute stress disorder treatment, adjustment disorder therapy seniors, behavioral disturbance treatment dementia, therapy programs family involvement, evidence-based mental health therapy, geriatric psychiatric therapy, adult mental health therapy programs Pittsburgh",
    ogTitle: "Mental Health Conditions & Therapy Programs | Three Rivers",
    ogDescription: "Evidence-based therapy including EMDR and DBT for anxiety, depression, PTSD, schizophrenia, and dementia in adults and seniors.",
    structuredData: {
      "@context": "https://schema.org",
      "@type": "MedicalTherapy",
      "name": "Conditions and Therapy Programs",
      "provider": { "@id": "https://trbhcares.com/#hospital" },
      "description": "Comprehensive therapy programs including EMDR and DBT for treating anxiety, depression, PTSD, schizophrenia, dementia, and other psychiatric conditions in adults and seniors.",
      "treatsHealthCondition": [
        "Anxiety Disorders",
        "Depression",
        "PTSD",
        "Schizophrenia",
        "Dementia",
        "Alzheimer's Disease"
      ]
    }
  },
  "nutrition-program": {
    title: "Nutrition Program | Three Rivers Behavioral Health",
    description: "Nutrition program supporting mental health treatment for adults and seniors, with registered dietitians and personalized meal plans in West Mifflin, PA.",
    keywords: "mental health nutrition program, psychiatric hospital food services, dietitian for mental health patients, nutrition support elderly psychiatric care, meal planning mental health hospital, dietary needs seniors mental health, registered dietitian psychiatric facility, nutrition and mental health seniors, eating support dementia patients, dietary accommodations psychiatric hospital, nutrition program elderly depression, food and mental health connection, specialized diet mental health treatment, nutritional support psychiatric inpatient, meals for psychiatric patients, dietary consultation mental health, nutrition therapy seniors Pittsburgh, psychiatric hospital dietary services, healthy eating mental health recovery, nutrition assessment psychiatric care, dietary support elderly hospitalization, meal supervision psychiatric unit, nutrition counseling mental health, dietary restrictions psychiatric hospital, food allergies mental health facility",
    ogTitle: "Nutrition Program for Mental Health Treatment | Three Rivers",
    ogDescription: "Expert dietary support and nutrition counseling as part of comprehensive mental health treatment for adults and seniors.",
    structuredData: {
      "@context": "https://schema.org",
      "@type": "MedicalTherapy",
      "name": "Nutrition Program",
      "provider": { "@id": "https://trbhcares.com/#hospital" },
      "description": "Comprehensive nutrition program with registered dietitians providing personalized dietary support for mental health patients."
    }
  },
  "brochure": {
    title: "Brochure | Three Rivers Behavioral Health",
    description: "Download the Three Rivers Behavioral Health brochure: psychiatric programs, services and admissions for adults and seniors in West Mifflin, PA.",
    keywords: "Three Rivers behavioral health brochure, psychiatric hospital information PDF, mental health facility brochure Pittsburgh, download psychiatric hospital guide, mental health services brochure, psychiatric care information packet, hospital brochure for families, mental health facility overview, psychiatric program details, admission information brochure, what to expect psychiatric hospital guide, mental health hospital brochure elderly, psychiatric services guide seniors, family guide psychiatric hospitalization, mental health facility information sheet",
    ogTitle: "Three Rivers Behavioral Health Brochure & Information",
    ogDescription: "Download comprehensive information about our psychiatric programs, services, and admission process.",
    structuredData: {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Three Rivers Behavioral Health Brochure",
      "provider": { "@id": "https://trbhcares.com/#hospital" },
      "description": "Informational brochure about Three Rivers Behavioral Health programs and services."
    }
  }
};

const pageSeo = seoData[focus as string] || {
  title: "Three Rivers Behavioral Health | Mental Health Programs",
  description: "Comprehensive psychiatric care programs at Three Rivers Behavioral Health",
  keywords: "mental health programs, psychiatric care",
  ogTitle: "Three Rivers Behavioral Health",
  ogDescription: "Mental health care programs for adults and seniors"
};

const canonicalUrl = `https://trbhcares.com/our-focus/${focus}`;

// Breadcrumb Structured Data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://trbhcares.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Our Programs",
      "item": "https://trbhcares.com/our-focus"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": pageSeo.title.split("|")[0].trim(),
      "item": canonicalUrl
    }
  ]
};

const structuredDataArray = pageSeo.structuredData
  ? [pageSeo.structuredData, breadcrumbStructuredData]
  : [breadcrumbStructuredData];
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  keywords={pageSeo.keywords}
  ogTitle={pageSeo.ogTitle}
  ogDescription={pageSeo.ogDescription}
  ogImage="https://trbhcares.com/background/Our_Focus_Banner.jpg"
  ogUrl={canonicalUrl}
  twitterTitle={pageSeo.ogTitle}
  twitterDescription={pageSeo.ogDescription}
  twitterImage="https://trbhcares.com/background/Our_Focus_Banner.jpg"
  canonicalUrl={canonicalUrl}
  structuredData={structuredDataArray}
>
  <FocusPage title={focus} pathname={`/our-focus/${focus}`} />
</Layout>
